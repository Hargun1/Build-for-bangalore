# Copy to server/.env and fill in. Never commit the real .env.

PORT=5001
NODE_ENV=development

# MongoDB Atlas free M0 cluster: https://www.mongodb.com/cloud/atlas/register
# Leave empty in local development to use a temporary in-memory database.
MONGODB_URI=

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Where the React app runs (used for CORS).
CLIENT_URL=http://localhost:3000

# Python AI service and the shared secret both services must have.
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_TOKEN=

# Google sign-in (optional): OAuth client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Gmail for verification codes, SOS alerts and appointment emails (optional in development).
# Use a 16-character App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_PASSWORD=
