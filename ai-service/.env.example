# Copy to ai-service/.env and fill in. Never commit the real .env.
# Set at least ONE provider key. All three have free tiers; with more than one,
# the service falls back automatically when a provider is rate-limited or down.

# Google AI Studio (text + images): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (fast text): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (free models, text + images): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Must match AI_INTERNAL_TOKEN in server/.env.
AI_INTERNAL_TOKEN=

# Optional overrides (comma-separated, tried in order).
# LLM_PROVIDER_ORDER=gemini,groq,openrouter
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_VISION_MODELS=google/gemma-4-31b-it:free
# LLM_TIMEOUT_SECONDS=40
